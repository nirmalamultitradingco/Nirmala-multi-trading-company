{
  "name": "food-export-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full-stack food export merchant website — React (client) + Express/MongoDB (server).",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "start": "node server/server.js",
    "seed": "npm --prefix server run seed",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

